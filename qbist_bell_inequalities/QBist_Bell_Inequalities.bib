@article{10.5555/2011528.2011532,
author = {Masanes, Ll},
title = {{Tight Bell inequality for d-outcome measurements correlations}},
year = {2003},
issue_date = {July 2003},
publisher = {Rinton Press, Incorporated},
address = {Paramus, NJ},
volume = {3},
number = {4},
issn = {1533-7146},
abstract = {In this paper we prove that the inequality introduced by Collins, Gisin, Linden, Massar and Popescu [11] is tight, or in other words, it is a facet of the convex polytope generated by all local-realistic joint probabilities of d outcomes. This means that this inequality is optimal. We also show that, for correlation functions generalized to deal with three-outcome measurements, the satisfyability of this inequality is a necessary and sufficient condition for the existence of a local-realistic model accounting for them.},
journal = {Quantum Info. Comput.},
month = jul,
pages = {345–358},
numpages = {14},
keywords = {bell inequality, d-outcome measurements}
}

